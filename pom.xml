<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.fire.im</groupId>
    <artifactId>fire-im</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>fire-im</name>
    <packaging>pom</packaging>
    <description>parent project</description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
    </parent>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.36</lombok.version>
        <netty.version>4.1.118.Final</netty.version>
        <apache.common.version>3.17.0</apache.common.version>
        <apache.common.codec>1.17.1</apache.common.codec>
        <guava.version>33.4.0-jre</guava.version>
        <zkclient.version>0.11</zkclient.version>
        <protobuf.version>3.25.5</protobuf.version>
        <fire-im.version>0.0.1-SNAPSHOT</fire-im.version>
        <knife4j.starter.version>4.5.0</knife4j.starter.version>
        <jakarta.validation.version>3.1.0</jakarta.validation.version>
        <openfeign.version>13.14</openfeign.version>
        <swagger.version>2.2.28</swagger.version>
    </properties>

    <modules>
        <module>fire-im-common</module>
        <module>fire-im-server-api</module>
        <module>fire-im-route-api</module>
        <module>fire-im-server</module>
        <module>fire-im-route</module>
        <module>fire-im-client</module>
        <module>firm-im-user</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--lombok project-->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--netty-->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fire.im.common</groupId>
                <artifactId>fire-im-common</artifactId>
                <version>${fire-im.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fire.im.server.api</groupId>
                <artifactId>fire-im-server-api</artifactId>
                <version>${fire-im.version}</version>
            </dependency>

            <dependency>
                <groupId>com.fire.im.route.api</groupId>
                <artifactId>fire-im-route-api</artifactId>
                <version>0.0.1-SNAPSHOT</version>
            </dependency>
            <!--apache common lang3-->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${apache.common.version}</version>
            </dependency>

            <dependency>
                <groupId>commons-codec</groupId>
                <artifactId>commons-codec</artifactId>
                <version>${apache.common.codec}</version>
            </dependency>

            <!--google guava-->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <!--google protobuf-->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <!--google protobuf util-->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <!--zookeeper client-->
            <dependency>
                <groupId>com.101tec</groupId>
                <artifactId>zkclient</artifactId>
                <version>${zkclient.version}</version>
            </dependency>

            <!--knife4j-->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.starter.version}</version>
            </dependency>

            <!--openfeign-->
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-core</artifactId>
                <version>${openfeign.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.openfeign</groupId>
                <artifactId>feign-jackson</artifactId>
                <version>${openfeign.version}</version>
            </dependency>

            <!--swagger v3 annotations-->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>

            <!--jakarta validation-->
            <dependency>
                <groupId>jakarta.validation</groupId>
                <artifactId>jakarta.validation-api</artifactId>
                <version>${jakarta.validation.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
